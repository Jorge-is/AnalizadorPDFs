# ==========================================
# Ejemplo de variables de entorno
# ==========================================

# Copia este archivo y cámbiale el nombre a «.env»

# A continuación, rellena los valores según tu entorno.

# --------------------------------------------------
# Configuración de Gemini AI
# -------------------------------------- ------------

# Clave API utilizada para acceder a los servicios de Google Gemini.

# Puedes obtenerla en: https://aistudio.google.com/

GEMINI_API_KEY=

# ----------------------------------------- ---------
# Seguridad de Flask
# --------------------------------------------------

# Clave secreta utilizada por Flask para firmar cookies de sesión

# y otras necesidades relacionadas con la seguridad.

SECRET_KEY=

# --------------------------------------------------
# Configuración de Celery + Redis
# --------------------------------------------------

# URL de Redis utilizada como intermediario de mensajes para Celery.

# Ejemplo para desarrollo local: redis://localhost:6379/0

CELERY_BROKER_URL=

# URL de Redis utilizada por Celery para almacenar los resultados de las tareas.

# Normalmente es la misma que la URL del intermediario en desarrollo.

CELERY_RESULT_BACKEND=